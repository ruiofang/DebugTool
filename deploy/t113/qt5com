#!/bin/sh
set -eu
QT5COM_HOME=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-linuxfb:fb=/dev/fb0:mmsize=212x339}"
export QT_FONT_DPI=96
export QT5COM_PORTRAIT=1
export QT5COM_FULLSCREEN=1
cd "$QT5COM_HOME/app"
exec "$QT5COM_HOME/bin/python" "$QT5COM_HOME/app/main.py" "$@"
